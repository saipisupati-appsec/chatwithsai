# ChatWithSai – Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real secrets.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:4567

# Optional limits (defaults applied in code if unset)
# MAX_QUESTION_LENGTH=2000
# MAX_URL_LENGTH=2000
# MAX_REQUEST_BODY=20480
# MAX_JOB_PAGE_SIZE=5242880
# MAX_REDIRECTS=3
# MAX_LLM_INPUT_TOKENS=3000
# MAX_LLM_OUTPUT_TOKENS=500
